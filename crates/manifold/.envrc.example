# Manifold provider credentials
#
# Manifold resolves API keys from secret backends — not from this file.
#
# Local dev (macOS): store keys in Keychain:
#   security add-generic-password -a "$USER" -s openai-api-key -w
# Service names follow the logical key: OPENAI_API_KEY → openai-api-key
#
# Deployed (GCP): Runtime Runway Secret Manager naming:
#   {env}-platform-{short_name}  or  {env}-{app}-{short_name}
# Set GCP_PROJECT (or GOOGLE_CLOUD_PROJECT), ENV, and APP_NAME in the host.
#
# CI only: set MANIFOLD_ALLOW_ENV_SECRETS=1 to read keys from the environment.
#
# Non-secret config (gateway URLs, model overrides) may still use env:
export KONG_AI_GATEWAY_URL=https://c47529e9da.eu.serverless.gateways.konggateway.com
